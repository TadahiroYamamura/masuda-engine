{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "summary", "steps", "alternatives", "risks", "checks"],
  "properties": {
    "goal": {"type": "string", "pattern": "\\S"},
    "summary": {"type": "string", "pattern": "\\S"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "title", "description", "tests", "files"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "pattern": "\\S"},
          "description": {"type": "string", "pattern": "\\S"},
          "tests": {
            "type": "array",
            "minItems": 0,
            "items": {"type": "string", "pattern": "\\S"}
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/relpath"}
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option", "reason"],
        "properties": {
          "option": {"type": "string", "pattern": "\\S"},
          "reason": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"}
    },
    "expected_byproducts": {
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"}
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "question", "answer", "status"],
        "properties": {
          "id": {"$ref": "#/$defs/check-id"},
          "category": {"$ref": "#/$defs/category"},
          "question": {"type": "string", "pattern": "\\S"},
          "answer": {"type": "string"},
          "status": {"enum": ["addressed", "out_of_scope", "open"]}
        },
        "if": {"properties": {"status": {"enum": ["addressed", "out_of_scope"]}}},
        "then": {"properties": {"answer": {"pattern": "\\S"}}}
      }
    }
  },
  "$defs": {
    "check-id": {
      "description": "<category ID in upper case>-<number>, e.g. SPEC-1.",
      "type": "string",
      "pattern": "^[A-Z]+-[1-9][0-9]*$"
    },
    "category": {
      "enum": ["spec", "security", "data", "release", "regression", "performance", "maintainability", "other"]
    },
    "relpath": {
      "description": "Clean path relative to the repository root: no leading slash, no empty, '.' or '..' segments, no trailing slash.",
      "type": "string",
      "pattern": "^(?:[^/.][^/]*|\\.[^/.][^/]*|\\.\\.[^/]+)(?:/(?:[^/.][^/]*|\\.[^/.][^/]*|\\.\\.[^/]+))*$"
    }
  }
}
