{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "summary", "steps", "alternatives", "risks"],
  "properties": {
    "goal": {"type": "string", "pattern": "\\S"},
    "summary": {"type": "string", "pattern": "\\S"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "title", "description", "tests", "files"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "pattern": "\\S"},
          "description": {"type": "string", "pattern": "\\S"},
          "tests": {
            "type": "array",
            "minItems": 0,
            "items": {"type": "string", "pattern": "\\S"}
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/relpath"}
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option", "reason"],
        "properties": {
          "option": {"type": "string", "pattern": "\\S"},
          "reason": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"}
    },
    "expected_byproducts": {
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"}
    }
  },
  "$defs": {
    "relpath": {
      "description": "Clean path relative to the repository root: no leading slash, no empty, '.' or '..' segments, no trailing slash.",
      "type": "string",
      "pattern": "^(?:[^/.][^/]*|\\.[^/.][^/]*|\\.\\.[^/]+)(?:/(?:[^/.][^/]*|\\.[^/.][^/]*|\\.\\.[^/]+))*$"
    }
  }
}
