{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "comment-manifest",
  "x-masuda-accumulate": true,
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["file", "line", "kind", "note"],
    "properties": {
      "file": {
        "type": "string",
        "pattern": "^(?:[^/.][^/]*|\\.[^/.][^/]*|\\.\\.[^/]+)(?:/(?:[^/.][^/]*|\\.[^/.][^/]*|\\.\\.[^/]+))*$"
      },
      "line": {"type": "integer", "minimum": 1},
      "kind": {"enum": ["summary", "choice", "background", "tradeoff", "convention", "nolint"]},
      "note": {"type": "string", "pattern": "\\S"}
    }
  }
}
